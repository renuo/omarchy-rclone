#!/bin/bash

# Records every call. is-enabled and is-active answer from
# $FAKE_SYSTEMD/<unit>.enabled|.active; enable/disable fail with
# $FAKE_SYSTEMCTL_FAIL on stderr when it is set.

echo "$*" >>"$FAKE_SYSTEMCTL_ARGS"

args=("$@")
[[ ${args[0]} == --user ]] && args=("${args[@]:1}")
quiet=false
[[ ${args[0]} == -q ]] && quiet=true && args=("${args[@]:1}")

case ${args[0]} in
is-enabled | is-active)
  file="$FAKE_SYSTEMD/${args[1]}.${args[0]#is-}"
  answer=$([[ -f $file ]] && cat "$file" || echo inactive)
  [[ ${args[0]} == is-enabled && ! -f $file ]] && answer=disabled
  $quiet || echo "$answer"
  [[ $answer == enabled || $answer == active ]]
  ;;
enable | disable)
  if [[ -n ${FAKE_SYSTEMCTL_FAIL:-} ]]; then
    echo "$FAKE_SYSTEMCTL_FAIL" >&2
    exit 1
  fi
  echo "Created symlink, the way systemctl chats on stderr." >&2
  ;;
esac
